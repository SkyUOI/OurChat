FROM rustlang/rust:nightly-alpine AS builder

WORKDIR /app

# --no-cache keeps apk's cache out of the image. cargo-chef enables the
# planner/cook split in the main Dockerfile for dependency caching.
RUN apk add --no-cache \
        cmake \
        protobuf-dev \
        musl-dev \
        zlib-static \
        build-base \
        sccache \
        cargo-chef
